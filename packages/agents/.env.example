ECONOMY_ENGINE_ADDRESS=0x9228A8a257c9812dB43a21FFbb8dA946f69CbD61
QUEST_ENGINE_ADDRESS=0x609879C70B73E02F6439851f15440E40D77dB980
GOVERNANCE_DAO_ADDRESS=0x03388269b2FB4320D12B78d86585a36F4f8Ce481
MONSTER_REGISTRY_ADDRESS=0x2ffe61a58Ed0D86322E1da947f5Dd51c5a23Bd26
