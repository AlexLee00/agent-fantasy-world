# ============================================================
# AFW Agent Engine Configuration
# Copy to .env and fill in your values
# ============================================================

# -- Provider Selection --
# Choose: claude-code | openclaw | openai | anthropic | oauth | codex
BRAIN_PROVIDER=claude-code

# -- Claude Code CLI (primary) --
CLAUDE_CODE_PATH=/opt/homebrew/bin/claude
CLAUDE_CODE_MODEL=sonnet
CLAUDE_CODE_NAME=
CLAUDE_CODE_SETTINGS=
CLAUDE_CODE_AGENT=
CLAUDE_CODE_TIMEOUT_MS=45000

# -- Direct API Key (simplest) --
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# -- OpenAI OAuth (for production / user-facing) --
OPENAI_OAUTH_CLIENT_ID=
OPENAI_OAUTH_CLIENT_SECRET=
OPENAI_OAUTH_REDIRECT_URI=http://localhost:8080/callback
OPENAI_OAUTH_TOKEN_PATH=.oauth/openai_token.json

# -- Codex OAuth session reuse (production-oriented) --
# Reuses the local `codex login` session from ~/.codex/auth.json by default.
CODEX_AUTH_FILE=~/.codex/auth.json

# -- OpenClaw OAuth session reuse (primary) --
OPENCLAW_AUTH_FILE=~/.openclaw/agents/main/agent/auth-profiles.json
OPENCLAW_AUTH_PROVIDER=openai-codex
OPENCLAW_AUTH_PROFILE=

# -- Anthropic (alternative) --
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI direct API uses API key auth today.
# For production-style delegated login in AFW, prefer OpenClaw OAuth reuse via BRAIN_PROVIDER=openclaw.

# -- Chain Settings --
RPC_URL=https://base-sepolia-rpc.publicnode.com
PRIVATE_KEY=0x...
AGENT_REGISTRY_ADDRESS=0xe0843f593f88375F13397d82c85F34b35992AA8c
SOUL_TOKEN_ADDRESS=0x12703AEc8ceE7F5AEB89B89fB46B86151e8E6da1
